{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "typeRoots": ["./.medrengard/node_modules/@types"]
  },
  "include": ["*.ts", "bin/*.ts", "dry/*.ts", "driver/*.ts", "test/*.ts"]
}
